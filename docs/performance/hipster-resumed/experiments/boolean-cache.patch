+//! Tick-end state plus ordered intra-tick records, with shadow checks at every
+//! cached strong-power query (including mutations inside the same tick).
+use mc_test::{build_sim, SettleMode};
+use mc_tick::{Pos, PowerCacheMode, Simulation, StateId, Structure};
+
+fn make(name: &str, mode: PowerCacheMode) -> Simulation {
+    let source = std::fs::read_to_string(format!(
+        "{}/tests/corpus/structures/{name}.snbt",
+        env!("CARGO_MANIFEST_DIR")
+    ))
+    .unwrap();
+    let structure = Structure::parse(&source).unwrap();
+    let settle = match name {
+        "flying_machine_east" => SettleMode::Quiet,
+        "adder32" => SettleMode::Placement,
+        _ => SettleMode::InWorld,
+    };
+    let mut sim = build_sim(
+        &structure,
+        Pos::default(),
+        settle,
+        &["minecraft:redstone_block".to_owned()],
+        &[],
+        Some(2730),
+        name,
+    );
+    sim.world_mut().set_power_cache_mode(mode);
+    sim.set_rng_seed(0);
+    sim.record();
+    sim.record_updates(true);
+    sim
+}
+fn input(sim: &mut Simulation, name: &str, tick: u64) {
+    match name {
+        "hipster_door" if matches!(tick % 320, 10 | 170) => sim.use_block(Pos::new(12, 7, 13)),
+        "door_6x6_inworld" if tick == 0 => sim.use_block(Pos::new(10, 4, 1)),
+        "bb" if tick == 0 => {
+            sim.place_block(Pos::new(31, 7, 13), StateId::AIR);
+        }
+        "flying_machine_east" if tick == 2 => {
+            let id = sim.registry().get("minecraft:redstone_block").unwrap();
+            sim.place_block(Pos::new(2, 1, 1), id);
+        }
+        "flying_machine_east" if tick == 4 => {
+            sim.place_block(Pos::new(2, 1, 1), StateId::AIR);
+        }
+        _ => {}
+    }
+}
+#[test]
+fn dynamic_circuits_match_uncached_state_and_ordered_deliveries() {
+    for (name, ticks) in [
+        ("hipster_door", 640),
+        ("door_6x6_inworld", 100),
+        ("flying_machine_east", 244),
+        ("bb", 230),
+        ("adder32", 500),
+        ("comparator_drain", 80),
+        ("item_into_hopper", 80),
+    ] {
+        let mut off = make(name, PowerCacheMode::Off);
+        let mut cached = make(name, PowerCacheMode::Shadow);
+        let mut cursors = [0; 4];
+        for tick in 0..ticks {
+            input(&mut off, name, tick);
+            input(&mut cached, name, tick);
+            off.step();
+            cached.step();
+            assert_eq!(off.world(), cached.world(), "{name} tick {tick}");
+            assert_eq!(off.pending_ticks(), cached.pending_ticks());
+            assert_eq!(off.pending_events(), cached.pending_events());
+            assert_eq!(
+                &off.recorded()[cursors[0]..],
+                &cached.recorded()[cursors[0]..]
+            );
+            assert_eq!(
+                &off.recorded_updates()[cursors[1]..],
+                &cached.recorded_updates()[cursors[1]..]
+            );
+            assert_eq!(
+                format!("{:?}", &off.recorded_inventory()[cursors[2]..]),
+                format!("{:?}", &cached.recorded_inventory()[cursors[2]..])
+            );
+            assert_eq!(
+                format!("{:?}", &off.recorded_entities()[cursors[3]..]),
+                format!("{:?}", &cached.recorded_entities()[cursors[3]..])
+            );
+            cursors = [
+                off.recorded().len(),
+                off.recorded_updates().len(),
+                off.recorded_inventory().len(),
+                off.recorded_entities().len(),
+            ];
+            for (pos, _) in off.world().iter_non_air() {
+                assert_eq!(off.inventory(pos), cached.inventory(pos));
+            }
+            // Debug preserves NaN spellings in authored entities; float equality does not.
+            assert_eq!(
+                format!(
+                    "{:?}{:?}{:?}",
+                    off.item_entities(),
+                    off.minecarts(),
