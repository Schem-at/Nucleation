@@ -0,0 +1,196 @@
+//! Bounded, world-owned memoization of structural strong-power contributions.
+use crate::{Pos, ALL_DIRS};
+use std::sync::{Arc, Mutex};
+
+/// Control derived strong-power caching independently of simulation state.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub enum PowerCacheMode {
+    /// Recompute every query (the reference implementation).
+    #[default]
+    Off,
+    /// Cache structural contributions, reading comparator outputs live.
+    On,
+    /// Recompute cached results too, asserting exact equality. Not for timings.
+    Shadow,
+}
+
+/// Identity is retained by the cache so allocator address reuse cannot hit an
+/// old rules table. A cloned rules table gets a fresh identity.
+#[derive(Debug, Default)]
+pub(crate) struct RulesIdentity(Arc<()>);
+impl Clone for RulesIdentity {
+    fn clone(&self) -> Self {
+        Self::default()
+    }
+}
+
+#[derive(Debug, Default, Clone, Copy)]
+pub(crate) struct Contribution {
+    pub(crate) fixed: u8,
+    pub(crate) comparators: u8,
+}
+impl Contribution {
+    pub(crate) fn value(self, pos: Pos, outs: &crate::behaviour::ComparatorOutputs) -> u8 {
+        if self.comparators == 0 { return self.fixed; }
+        let mut best = self.fixed;
+        for (i, dir) in ALL_DIRS.into_iter().enumerate() {
+            if self.comparators & (1 << i) != 0 {
+                best = best.max(outs.get(&pos.offset(dir)).copied().unwrap_or(0));
+            }
+        }
+        best
+    }
+}
+
+const SLOTS: usize = 1024;
+#[derive(Debug, Clone, Copy)]
+struct Entry {
+    generation: u64,
+    pos: Pos,
+    wires: bool,
+    contribution: Contribution,
+}
+#[derive(Default)]
+struct Table {
+    generation: u64,
+    rules: Option<Arc<()>>,
+    entries: Vec<Option<Entry>>,
+}
+
+pub(crate) struct PowerCache {
+    mode: PowerCacheMode,
+    table: Mutex<Table>,
+}
+impl Default for PowerCache {
+    fn default() -> Self {
+        Self {
+            mode: PowerCacheMode::Off,
+            table: Mutex::default(),
+        }
+    }
+}
+impl Clone for PowerCache {
+    fn clone(&self) -> Self {
+        Self {
+            mode: self.mode,
+            ..Self::default()
+        }
+    }
+}
+// Cache contents/configuration are not physical world state.
+impl PartialEq for PowerCache {
+    fn eq(&self, _: &Self) -> bool {
+        true
+    }
+}
+impl Eq for PowerCache {}
+impl std::fmt::Debug for PowerCache {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PowerCache")
+            .field("mode", &self.mode)
+            .finish_non_exhaustive()
+    }
+}
+impl PowerCache {
+    pub(crate) fn mode(&self) -> PowerCacheMode {
+        self.mode
+    }
+    pub(crate) fn set_mode(&mut self, mode: PowerCacheMode) {
+        *self = Self {
+            mode,
+            ..Self::default()
+        };
+    }
+    pub(crate) fn invalidate(&mut self) {
+        let table = self.table.get_mut().unwrap_or_else(|p| p.into_inner());
+        table.generation = table.generation.wrapping_add(1);
+        if table.generation == 0 {
+            table.entries.fill(None);
+        }
+    }
+    fn slot(pos: Pos, wires: bool) -> usize {
+        let hash = (pos.x as u32).wrapping_mul(0x9e3779b1)
+            ^ (pos.y as u32).wrapping_mul(0x85ebca77)
+            ^ (pos.z as u32).wrapping_mul(0xc2b2ae3d);
+        ((hash ^ (hash >> 16)).wrapping_mul(2) as usize + usize::from(wires)) & (SLOTS - 1)
+    }
+    pub(crate) fn get_or_compute(
+        &self,
+        rules: &RulesIdentity,
+        pos: Pos,
+        wires: bool,
+        compute: impl FnOnce() -> Contribution,
+    ) -> Option<Contribution> {
+        if self.mode == PowerCacheMode::Off {
+            return None;
+        }
+        // Contention or a poisoned mutex simply takes the uncached path.
+        let mut table = self.table.try_lock().ok()?;
+        if !table
+            .rules
+            .as_ref()
+            .is_some_and(|id| Arc::ptr_eq(id, &rules.0))
+        {
+            table.rules = Some(Arc::clone(&rules.0));
+            table.entries.clear();
+        }
+        if table.entries.is_empty() {
+            table.entries.resize(SLOTS, None);
+        }
+        let slot = Self::slot(pos, wires);
+        if let Some(entry) = table.entries[slot] {
+            if entry.generation == table.generation && entry.pos == pos && entry.wires == wires {
+                return Some(entry.contribution);
+            }
+        }
+        let contribution = compute();
+        table.entries[slot] = Some(Entry {
+            generation: table.generation,
+            pos,
+            wires,
+            contribution,
+        });
+        Some(contribution)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn collision_rollover_clone_and_rules_identity_cannot_reuse_stale_values() {
+        fn send_sync<T: Send + Sync>() {}
+        send_sync::<crate::World>();
+        let mut cache = PowerCache::default();
+        cache.set_mode(PowerCacheMode::On);
+        let rules = RulesIdentity::default();
+        let p = Pos::new(-3, 2, -1);
+        let q = (0..10000)
+            .map(|x| Pos::new(x, 2, -1))
+            .find(|&q| PowerCache::slot(q, true) == PowerCache::slot(p, true))
+            .unwrap();
+        let get = |cache: &PowerCache, rules: &RulesIdentity, p, wires, n| {
+            cache
+                .get_or_compute(rules, p, wires, || Contribution {
+                    fixed: n,
+                    comparators: 0,
+                })
+                .unwrap()
+                .fixed
+        };
+        assert_eq!(get(&cache, &rules, p, true, 1), 1);
+        assert_eq!(get(&cache, &rules, p, true, 2), 1);
+        assert_eq!(get(&cache, &rules, q, true, 3), 3);
+        assert_eq!(get(&cache, &rules, p, true, 4), 4);
+        assert_eq!(get(&cache, &rules, p, false, 5), 5);
+        let copy = cache.clone();
+        assert_eq!(copy.mode(), PowerCacheMode::On);
+        assert_eq!(get(&copy, &rules, p, true, 6), 6);
+        assert_eq!(get(&cache, &rules.clone(), p, true, 7), 7);
+        cache.table.get_mut().unwrap().generation = u64::MAX;
+        assert_eq!(get(&cache, &rules, p, true, 8), 8);
+        cache.invalidate();
+        assert_eq!(get(&cache, &rules, p, true, 9), 9);
+        assert_eq!(cache.table.lock().unwrap().entries.len(), SLOTS);
+    }
+}
