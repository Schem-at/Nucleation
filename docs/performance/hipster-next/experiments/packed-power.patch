 impl VanillaRules {
+    fn classify_power(&self, state: StateId) -> PowerInfo {
+        let mut weak = 0;
+        if self.powered.contains(&state) {
+            for dir in crate::pos::ALL_DIRS {
+                if self.emit_only.get(&state).is_none_or(|only| *only == dir)
+                    && self.emit_except.get(&state).is_none_or(|except| *except != dir)
+                {
+                    weak |= 1 << dir as u8;
+                }
+            }
+        }
+        PowerInfo {
+            weak,
+            strong: self.strong_into.get(&state).map_or(0, |dir| weak & (1 << *dir as u8)),
+            level: self.analog_emission.get(&state).copied().unwrap_or(15),
+            flags: u8::from(self.comparators.contains(&state)) * PowerInfo::COMPARATOR
+                | u8::from(self.conductors.contains(&state)) * PowerInfo::CONDUCTOR,
+        }
+    }
+
+    #[inline]
+    fn power_info(&self, state: StateId) -> PowerInfo {
+        self.power_info.get(state.raw() as usize).copied()
+            .unwrap_or_else(|| self.classify_power(state))
+    }
