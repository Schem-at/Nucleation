+//! Experimental bounded memo of wire target structure. Dependencies are the
+//! 25 cells within Manhattan distance two. Comparator memory is read live.
+use crate::{Pos, behaviour::ComparatorOutputs};
+use std::sync::{Arc, OnceLock};
+
+/// Configuration of the experimental wire target cache.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum WirePowerCacheMode {
+    /// Always calculate from the current world.
+    Off,
+    /// Cache structure, with immediate local invalidation on world writes.
+    On,
+    /// Recompute every hit and assert that cached structure and answer agree.
+    Shadow,
+}
+
+const SLOTS: usize = 1024;
+const fn offsets() -> [Pos; 25] {
+    let mut result = [Pos::new(0, 0, 0); 25];
+    let mut i = 0;
+    let mut x: i32 = -2;
+    while x <= 2 {
+        let mut y: i32 = -2;
+        while y <= 2 {
+            let mut z: i32 = -2;
+            while z <= 2 {
+                if x.abs() + y.abs() + z.abs() <= 2 { result[i] = Pos::new(x,y,z); i += 1; }
+                z += 1;
+            }
+            y += 1;
+        }
+        x += 1;
+    }
+    result
+}
+pub(crate) const OFFSETS: [Pos; 25] = offsets();
+const fn indices() -> [u8; 125] {
+    let mut out = [255; 125]; let mut i = 0;
+    while i < 25 {
+        let p = OFFSETS[i]; out[((p.x+2)*25+(p.y+2)*5+p.z+2) as usize] = i as u8; i += 1;
+    }
+    out
+}
+const INDICES: [u8; 125] = indices();
+pub(crate) fn dependency(p: Pos) -> u32 {
+    let i = INDICES[((p.x+2)*25+(p.y+2)*5+p.z+2) as usize];
+    assert!(i < 25); 1 << i
+}
+fn add(a: Pos, b: Pos) -> Pos { Pos::new(a.x.wrapping_add(b.x),a.y.wrapping_add(b.y),a.z.wrapping_add(b.z)) }
+fn slot(p: Pos) -> usize {
+    let h = (p.x as u32).wrapping_mul(0x9e3779b1) ^ (p.y as u32).wrapping_mul(0x85ebca77) ^ (p.z as u32).wrapping_mul(0xc2b2ae3d);
+    ((h ^ (h >> 16)) as usize) & (SLOTS - 1)
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub(crate) struct Target {
+    pub fixed: [u8; 6],
+    pub comparators: [u32; 6],
+    pub wire: u8,
+}
+impl Target {
+    pub fn resolve(self, pos: Pos, outs: &ComparatorOutputs) -> u8 {
+        let mut block = 0;
+        for i in 0..6 {
+            let mut strength = self.fixed[i];
+            let mut mask = self.comparators[i];
+            while mask != 0 {
+                let index = mask.trailing_zeros() as usize; mask &= mask - 1;
+                strength = strength.max(outs.get(&add(pos, OFFSETS[index])).copied().unwrap_or(0));
+            }
+            block = block.max(strength);
+            if block == 15 { return 15; }
+        }
+        block.max(self.wire)
+    }
+}
+struct Storage { rules: Arc<()>, slots: Vec<OnceLock<(Pos, Target)>> }
+pub(crate) struct WireCache { pub mode: WirePowerCacheMode, storage: OnceLock<Storage> }
+impl Default for WireCache {
+    fn default() -> Self {
+        static MODE: OnceLock<WirePowerCacheMode> = OnceLock::new();
+        let mode = *MODE.get_or_init(|| match std::env::var("MC_TICK_POWER_CACHE").as_deref() {
+            Ok("on") => WirePowerCacheMode::On,
+            Ok("shadow") => WirePowerCacheMode::Shadow,
+            _ => WirePowerCacheMode::Off,
+        });
+        Self { mode, storage: OnceLock::new() }
+    }
+}
+impl Clone for WireCache {
+    fn clone(&self) -> Self { Self { mode: self.mode, storage: OnceLock::new() } }
+}
+impl WireCache {
+    pub fn clear(&mut self) { self.storage.take(); }
+    pub fn invalidate(&mut self, changed: Pos) {
+        if self.mode == WirePowerCacheMode::Off { return; }
+        let Some(storage) = self.storage.get_mut() else { return; };
+        for offset in OFFSETS {
+            let affected = add(changed, offset);
+            let entry = &mut storage.slots[slot(affected)];
+            if entry.get_mut().is_some_and(|(key,_)| *key == affected) { entry.take(); }
+        }
+    }
+    pub fn query(&self, rules: &Arc<()>, pos: Pos, compute: impl Fn() -> Target) -> Target {
+        let storage = self.storage.get_or_init(|| Storage {
+            rules: rules.clone(), slots: (0..SLOTS).map(|_| OnceLock::new()).collect(),
+        });
+        // A replacement immutable rules table gets an uncached answer. Keeping
+        // the original identity alive rules out allocator-address reuse.
+        if !Arc::ptr_eq(&storage.rules, rules) { return compute(); }
+        let (key, value) = storage.slots[slot(pos)].get_or_init(|| (pos, compute()));
+        // Collisions are never overwritten through shared access. A world
+        // mutation can clear the slot; until then the other key falls back.
+        if *key != pos { return compute(); }
+        if self.mode == WirePowerCacheMode::Shadow { assert_eq!(*value, compute(), "wire cache structural mismatch at {pos:?}"); }
+        *value
+    }
+}
