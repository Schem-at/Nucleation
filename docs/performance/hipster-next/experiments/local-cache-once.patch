+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{World, Bounds, StateId, Simulation};
+    use std::cell::Cell;
+    fn value(n: u8) -> Target { Target { wire: n, ..Target::default() } }
+    fn world() -> World {
+        let mut w = World::new(Bounds::new(Pos::new(-10,-10,-10), Pos::new(10,10,10)));
+        w.set_wire_power_cache_mode(WirePowerCacheMode::On); w
+    }
+    #[test]
+    fn every_dependency_invalidates_immediately_and_worlds_stay_send_sync() {
+        fn send_sync<T: Send + Sync>() {} send_sync::<World>();
+        let mut w = world(); let id = Arc::new(()); let pos = Pos::new(-3,1,-2);
+        let calls = Cell::new(0);
+        let compute = || { calls.set(calls.get()+1); value(3) };
+        w.wire_cache.query(&id,pos,compute);
+        w.wire_cache.query(&id,pos,compute); assert_eq!(calls.get(),1);
+        for (i, offset) in OFFSETS.into_iter().enumerate() {
+            w.set(add(pos,offset),StateId(1));
+            w.wire_cache.query(&id,pos,compute); assert_eq!(calls.get(),i+2);
+        }
+        // A refused write is harmless and still invalidates affected entries.
+        w.set_growth_limit(0);
+        w.set(Pos::new(-11,0,0), StateId(1));
+        assert_eq!(w.wire_cache.query(&id,pos,compute),value(3));
+    }
+    #[test]
+    fn collisions_rules_replacement_clone_growth_and_restore_cannot_reuse_stale_data() {
+        let mut w = world(); let a = Pos::new(-1,0,0); let id = Arc::new(());
+        let b = (1..100000).map(|x| Pos::new(x,0,0)).find(|p| slot(*p)==slot(a)).unwrap();
+        assert_ne!(a,b);
+        assert_eq!(w.wire_cache.query(&id,a,|| value(1)),value(1));
+        assert_eq!(w.wire_cache.query(&id,b,|| value(2)),value(2));
+        assert_eq!(w.wire_cache.query(&id,a,|| value(3)),value(1));
+        let other = Arc::new(());
+        assert_eq!(w.wire_cache.query(&other,a,|| value(4)),value(4));
+        assert_eq!(w.clone().wire_cache.query(&other,a,|| value(5)),value(5));
+        assert!(w.grow_to_include(Pos::new(20,0,0)));
+        assert_eq!(w.wire_cache.query(&other,a,|| value(6)),value(6));
+        let mut sim = Simulation::new(w.bounds());
+        sim.world_mut().set_wire_power_cache_mode(WirePowerCacheMode::Off);
+        let checkpoint = sim.checkpoint();
+        sim.world_mut().set_wire_power_cache_mode(WirePowerCacheMode::Shadow);
+        sim.world().wire_cache.query(&id,a,|| value(7));
+        sim.restore(&checkpoint);
+        assert_eq!(sim.world().wire_power_cache_mode(),WirePowerCacheMode::Shadow);
+        assert_eq!(sim.world().wire_cache.query(&id,a,|| value(8)),value(8));
+    }
+    #[test]
+    fn live_dependency_masks_keep_zero_insert_remove_entry_and_replacement() {
+        let pos = Pos::new(-4,2,-9); let relative = Pos::new(1,0,0); let at = add(pos,relative);
+        let mut target = Target::default(); target.comparators[0] = dependency(relative);
+        let mut outs = ComparatorOutputs::new();
+        assert_eq!(target.resolve(pos,&outs),0);
+        for level in [0,1,15,16,255,0] {
+            outs.insert(at,level); assert_eq!(target.resolve(pos,&outs),level);
+        }
+        *outs.entry(at).or_default()=17; assert_eq!(target.resolve(pos,&outs),17);
+        outs.remove(&at); assert_eq!(target.resolve(pos,&outs),0);
+        outs = ComparatorOutputs::from([(at,127)]); assert_eq!(target.resolve(pos,&outs),127);
+        // Exact-15 early exit is ordered: a later 255 cannot override it.
+        target.fixed[1] = 255; outs.insert(at,15); assert_eq!(target.resolve(pos,&outs),15);
+        outs.insert(at,16); assert_eq!(target.resolve(pos,&outs),255);
+    }
+}
