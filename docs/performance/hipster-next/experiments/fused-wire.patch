+    /// Share the six immediate block reads between non-wire and dust input
+    /// calculations. This is a stack snapshot during a pure query, never a
+    /// memo retained across a world or comparator-output mutation.
+    fn wire_target(&self, world: &World, outs: &crate::behaviour::ComparatorOutputs, pos: Pos) -> u8 {
+        let neighbours = world.neighbours(pos);
+        let mut block = 0u8;
+        for (dir, state) in crate::pos::ALL_DIRS.into_iter().zip(neighbours) {
+            let at = pos.offset(dir);
+            let mut signal = self.emitted_state(world, outs, at, state, dir.opposite(), false);
+            if self.conductors.contains(&state) {
+                signal = signal.max(self.direct_signal_to(world, outs, at, false));
+            }
+            block = block.max(signal);
+            // Preserve the existing exact-15 short circuit, including its
+            // behaviour for arbitrary u8 comparator and analog outputs.
+            if block == 15 { return 15; }
+        }
+        let covered = self.conductors.contains(&neighbours[Dir::Up as usize]);
+        let mut wire = 0u8;
+        for dir in crate::wire::WIRE_SIDES {
+            let state = neighbours[dir as usize];
+            if let Some((power, _)) = self.wires.get(&state) { wire = wire.max(*power); }
+            let conductor = self.conductors.contains(&state);
+            if !conductor || !covered {
+                let step = if conductor { Dir::Up } else { Dir::Down };
+                let state = world.get(pos.offset(dir).offset(step));
+                if let Some((power, _)) = self.wires.get(&state) { wire = wire.max(*power); }
+            }
+        }
+        block.max(wire.saturating_sub(1))
+    }
