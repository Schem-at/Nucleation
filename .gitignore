examples/**/node_modules/

# Scratch that other toolchains write into whatever directory they are run from.
# pagina's and Kineglyph's test suites create temp trees with mkdtemp; when TMPDIR is
# relative (or unset in a sandbox) those land here rather than in /tmp, and a stray
# `git add` would sweep in tens of thousands of files. The real fix belongs in those
# repos; this keeps their accidents out of this one's status.
/pagina-*/
/kg-prerender-*/
/playwright-transform-cache-*/
/smoke-*/
/nucleation-replace-*/
/laravel-blade*
apps/*/dist/
apps/*/*/dist/
apps/*/backend/.venv/
apps/*/backend/jobs/
apps/*/backend/*.log
apps/*/backend/*.pid
apps/*/preview.log
apps/*/preview.pid
apps/*/screenshots/
apps/*/*/screenshots/
apps/*/public/engine/
apps/*/public/pack/
apps/shared-pack/
# Assembled browser wasm package (rebuild via tools/package-npm.sh)
dist/npm-mctick/
apps/*/preview-*.log
apps/*/verify-*-out.json
apps/preview.pid

# Per-agent gametest scratch dirs (jars, .class files, staged worlds)
/tools/gametest/work-*/

# Stray nanobind object files: the Python binding build writes these into the
# repo root when run outside its build dir (91 of them after one gen-bindings run).
*.o
*.o.tmp
# Raw lithium gametest structures, fetched at a pinned commit by
# tools/fetch-lithium-gametests.sh. The converted self-contained .litematic
# tests in tests/corpus/lithium-litematic/ ARE tracked (with their NOTICE);
# this raw mirror regenerates on demand.
tests/corpus/lithium/

# Scratch run logs.
/logs

# ---------------------------------------------------------------------------
# Build output must never be committed. target/ reached 102 GB on one machine
# (774k files in debug/deps alone); a single tracked artifact makes every clone
# pay for it forever. The `hygiene` job in .github/workflows/dev-tiers.yml
# fails the build if any of this becomes tracked.
# See docs/DEV.md → "Disk hygiene" for when and how to prune.
# ---------------------------------------------------------------------------
# Cargo target dirs anywhere in the tree (crates/*, bindings/*, examples/*),
# not just the root one already listed at the top of this file.
**/target/
# Input stamps written by tools/package-npm.sh so an unchanged wasm/npm package
# is skipped instead of rebuilt.
.build-stamp

# Local integration probes and generated experiment workspaces. The source,
# reports and compact problem/gallery corpora are tracked; rerunnable working
# directories and downloaded resource packs are not release artifacts.
/nucleation-pipe-list-test/
/nucleation-pipe-test/
/pack.zip
/build.png
/redstone-eda/adversarial/work/
/redstone-eda/adversarial/work2/
/redstone-eda/adversarial/work3/
/redstone-eda/adversarial/codex_log.jsonl
**/__pycache__/
